@page "/peugeot-206"

@inject IJSRuntime js

<PageTitle>MarDevs - Venta</PageTitle>

<div class="row">
    <div class="col-12">
        <h2 class="text-center">Peugeot 206 XT 1.6 5 Puertas</h2>        
    </div>    
</div>

<div class="row">
    <div class="col-12 col-lg-6">

        @if (@items != null)
        {

            <BSCarousel HasControls="true" HasIndicators="true" IsFade="true">
                 @foreach(var item in items)
                    {
                        <BSCarouselItem>                                                  
                            <img src="@item.Source" class="img-fluid" alt="@item.Alt"/>                    
                        </BSCarouselItem>             
                    }   
            </BSCarousel>
        }        
    </div>
    <div class="col-12 col-lg-6 mt-resize">        
        <h2 class="float-end" style="color:green"><b>ARS 690.000</b></h2>
        @*<h5 style="padding-top:10px;" class="text-nowrap">Características</h5>*@
        <table class="table table-striped table-sm">           
            <tbody>
                <tr>
                    <td><b>Marca</b></td>
                    <td>Peugeot</td>
                </tr>
                <tr>
                    <td><b>Modelo</b></td>
                    <td>206 XT</td>
                </tr>
                <tr>
                    <td><b>Año</b></td>
                    <td>1999</td>
                </tr>
                <tr>
                    <td><b>Color</b></td>
                    <td>Celeste</td>
                </tr>
                <tr>
                    <td><b>Tipo Combustible</b></td>
                    <td>Nafta</td>
                </tr>
                <tr>
                    <td><b>Puertas</b></td>
                    <td>5</td>
                </tr>
                <tr>
                    <td><b>Transmisión</b></td>
                    <td>Manual</td>
                </tr>
                <tr>
                    <td><b>Motor</b></td>
                    <td>1.6</td>
                </tr>
                <tr>
                    <td><b>Tipo Carrocería</b></td>
                    <td>Hatchback</td>
                </tr>
                <tr>
                    <td><b>Kilómetros</b></td>
                    <td>180.000</td>
                </tr>
            </tbody>        
        </table>

         <hr />   

         <h5>Información general/comodidades</h5>
         <ul>
             <li>Aire Acondicionado</li>
             <li>Levanta vidrios eléctricos delanteros</li>
             <li>Comando eléctrico interior retrovisores</li>
             <li>Cierre centralizado</li>
             <li>Airbag conductor y acompañante</li>
             <li>Rueda de auxilio con kit completo</li>
             <li>Faros antiniebla delanteros y trasero</li>
             <li>Estereo usb + 4 parlantes (los 2 delanteros nuevos)</li>
             <li>Techo solar corredizo</li>
         </ul>

         <hr />   

         <h5>Observaciones</h5>
         <p>
             Titular con papeles al día listo para transferir SIN deudas.<br />
             Excelente andar, mecánica y VTV al día. Tiene detalles de chapa y pintura propios del uso y el tiempo; el Interior está en excelentes condiciones, polarizado nuevo.<br />             
             Se puede pasar a ver coordinando previamente, me encuentro en Hurlingham, Zona Oeste del Gran Buenos Aires.<br />
             El precio se puede conversar.
         </p>

          <hr /> 
          <p>Podés contactarme al whatsapp o por correo a: martinreina84@hotmail.com</p>

    </div>
</div>

